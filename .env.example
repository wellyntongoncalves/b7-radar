# ─── B7 Radar — variáveis de ambiente (exemplo) ───────────────────────────────
# Copie para .env e preencha. NUNCA commite o .env real.

# App web (Next.js / Vercel)
NEXT_PUBLIC_APP_NAME="B7 Radar"
NEXT_PUBLIC_API_URL="http://localhost:3333"

# Backend (Fastify) — opcional no MVP
API_PORT=3333
API_HOST=0.0.0.0
# Allowlist de origens para CORS (separadas por vírgula). Vazio = sem cross-origin.
CORS_ORIGINS="http://localhost:3000"
# Segredo para assinar o cookie de sessão do OAuth (obrigatório em produção/OAuth).
COOKIE_SECRET=""

# Banco (Supabase / PostgreSQL) — opcional no MVP
DATABASE_URL="postgresql://user:password@localhost:5432/b7radar"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Criptografia de tokens do marketplace (AES-256-GCM). 32 bytes em base64.
TOKEN_ENCRYPTION_KEY=""

# OAuth Mercado Livre — usado apenas quando o usuário conecta a conta
ML_OAUTH_CLIENT_ID=""
ML_OAUTH_CLIENT_SECRET=""
ML_OAUTH_REDIRECT_URI="http://localhost:3333/auth/mercadolivre/callback"

# IA (B7 Studio) — desacoplado, fora do núcleo do MVP
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""

# Redis (fila/cache) — apenas quando o worker existir (fase 2)
REDIS_URL="redis://localhost:6379"
